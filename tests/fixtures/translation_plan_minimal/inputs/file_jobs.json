      {
        "id": "chapter01/dialogue.rpy:chapter01_start:1:10a68e16",
        "text": "Hey [Gil_name!t], did you finish the Dawn Chorus setlist?",
        "line": 6,
        "speaker_id": "g",
        "speaker_name": "Gil",
        "block_name": "chapter01/dialogue.rpy::chapter01_start"
      },
      {
        "id": "chapter01/dialogue.rpy:chapter01_start:2:c4d75441",
        "text": "Almost. {i}Almost{/i} is the operative word, Gil.",
        "line": 7,
        "speaker_id": "p",
        "speaker_name": "Parker",
        "block_name": "chapter01/dialogue.rpy::chapter01_start"
      },
      {
        "id": "chapter01/dialogue.rpy:chapter01_start:3:39f88feb",
        "text": "Mrs. Parker will flip if we're late to rehearsal again.",
        "line": 8,
        "speaker_id": "g",
        "speaker_name": "Gil",
        "block_name": "chapter01/dialogue.rpy::chapter01_start"
      },
      {
        "id": "chapter01/dialogue.rpy:chapter01_start:4:23a766ca",
        "text": "Relax. I kept the B-side as the encore, like you asked.",
        "line": 9,
        "speaker_id": "p",
        "speaker_name": "Parker",
        "block_name": "chapter01/dialogue.rpy::chapter01_start"
      },
      {
        "id": "chapter01/dialogue.rpy:chapter01_hall:1:aa916e5f",
        "text": "You two. Practice room, five minutes, or the setlist is cut.",
        "line": 13,
        "speaker_id": "m",
        "speaker_name": "Mrs. Parker",
        "block_name": "chapter01/dialogue.rpy::chapter01_hall"
      },
      {
        "id": "chapter01/dialogue.rpy:chapter01_hall:2:e0e4d9f7",
        "text": "On it! Come on, [Parker_last!t], move!",
        "line": 14,
        "speaker_id": "g",
        "speaker_name": "Gil",
        "block_name": "chapter01/dialogue.rpy::chapter01_hall"
      }
    ]
  },
